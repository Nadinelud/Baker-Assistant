{
  "expo": {
    "name": "Baker Assistant",
    "slug": "bake-assistant",
    "scheme": "bakeassistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.bakeassistant.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Izinkan $(PRODUCT_NAME) memakai kamera untuk memotret hasil bake dan resep dari buku.",
          "photosPermission": "Izinkan $(PRODUCT_NAME) membuka galeri untuk memilih foto hasil bake dan resep.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B84A2E"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
